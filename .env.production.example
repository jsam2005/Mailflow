ENVIRONMENT=production
APP_VERSION=0.1.0

# Neon / external PostgreSQL (use pooled URL when available)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DB?sslmode=require

JWT_SECRET=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/email-accounts/google/callback

FRONTEND_URL=https://YOUR_DOMAIN
BACKEND_URL=https://YOUR_DOMAIN
CORS_ORIGINS=https://YOUR_DOMAIN
ALLOWED_HOSTS=YOUR_DOMAIN,.vercel.app

CRON_SECRET=replace-with-long-random-secret-min-32-chars
ENABLE_LOCAL_SCHEDULER=false

CAMPAIGN_SENDING_ENABLED=false
CAMPAIGN_WORKER_BATCH_SIZE=5
CAMPAIGN_WORKER_INTERVAL_SECONDS=5
CAMPAIGN_MAX_SEND_ATTEMPTS=3
APP_TIMEZONE=Asia/Kolkata
CAMPAIGN_TEST_RECIPIENT_ALLOWLIST=

STORAGE_PROVIDER=vercel_blob
BLOB_READ_WRITE_TOKEN=

BUSINESS_NAME=
BUSINESS_ADDRESS=
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=
TERMS_URL=
UNSUBSCRIBE_BASE_URL=https://YOUR_DOMAIN

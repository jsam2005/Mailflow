# Storage uploads (keep directory structure)
storage/imports/*
!storage/imports/.gitkeep
storage/template-images/*
!storage/template-images/.gitkeep
storage/attachments/*
!storage/attachments/.gitkeep
**/storage/imports/*
!**/storage/imports/.gitkeep
**/storage/template-images/*
!**/storage/template-images/.gitkeep
**/storage/attachments/*
!**/storage/attachments/.gitkeep

# Logs
*.log
logs/

# Local launcher runtime logs (never commit)
launcher/.runtime/*
!launcher/.runtime/.gitkeep

# Client update staging, locks, backups (never commit)
.mailflow/

# Local auth-email outbox (console/file provider artifacts)
**/storage/auth-email-outbox/*
!**/storage/auth-email-outbox/.gitkeep

# Duplicate docs archive / local media (not part of the app)
docs.zip
audio/

# Docker
docker-compose.override.yml

# Neon CLI link metadata (may contain project ids; keep local)
.neon
.neon/
.venv-vercel-test/
.vercel
.vercel-env-upload.tmp

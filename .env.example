# PostgreSQL
POSTGRES_USER=mailflow
POSTGRES_PASSWORD=mailflow_secret
POSTGRES_DB=mailflow
DATABASE_URL=postgresql+psycopg2://mailflow:mailflow_secret@localhost:5432/mailflow

# Security
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-generate-a-fernet-key==
CRON_SECRET=change-me-cron-secret-min-32-characters-long

# Application
ENVIRONMENT=development
APP_VERSION=0.1.0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=*
STORAGE_PATH=./storage
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=
ENABLE_LOCAL_SCHEDULER=true

# Dev admin bootstrap (ignored in production — use create_admin CLI)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Google OAuth (placeholders only — never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/email-accounts/google/callback
TEST_EMAIL_HOURLY_LIMIT=10
OAUTH_STATE_TTL_MINUTES=10

# Imports / templates
MAX_IMPORT_FILE_MB=10
IMPORT_BATCH_SIZE=500
MAX_TEMPLATE_IMAGE_MB=5

# Campaign delivery
CAMPAIGN_SENDING_ENABLED=false
CAMPAIGN_WORKER_INTERVAL_SECONDS=5
CAMPAIGN_WORKER_BATCH_SIZE=5
CAMPAIGN_MAX_SEND_ATTEMPTS=3
CAMPAIGN_STALE_SENDING_MINUTES=10
CAMPAIGN_RETRY_DELAY_1_SECONDS=300
CAMPAIGN_RETRY_DELAY_2_SECONDS=900
APP_TIMEZONE=Asia/Kolkata
# Empty = all recipients. Non-empty = allowlist (dev safety).
CAMPAIGN_TEST_RECIPIENT_ALLOWLIST=

# Compliance / footer (required before real marketing sends)
BUSINESS_NAME=
BUSINESS_ADDRESS=
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=
TERMS_URL=
UNSUBSCRIBE_BASE_URL=http://localhost:5173
